# Application Settings
PORT=":8080"

# CORS Configuration
# Explicitly lists the secure web origins authorized to communicate with your database
ALLOWED_ORIGINS="https://yourdomain.com,https://yourdomain.com,https://vercel.app"

# Local Mailpit SMTP settings
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USERNAME="" # in production, e.g: gmail address
SMTP_PASSWORD="" # in production, e.g: google password 
SMTP_FROM="no-reply@kanban.local"